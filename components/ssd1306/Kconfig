menu "SSD1306 / SH1106 OLED driver"

    choice SSD1306_PANEL
        prompt "OLED panel controller"
        default SSD1306_PANEL_SSD1306
        help
            Select the controller of your module. SSD1306 is the most common
            0.96" panel. SH1106 is often used on 1.3" panels and needs a
            2-column offset because it exposes 132 columns of RAM.
        config SSD1306_PANEL_SSD1306
            bool "SSD1306 (128x64, e.g. 0.96 inch)"
        config SSD1306_PANEL_SH1106
            bool "SH1106 (128x64, e.g. 1.3 inch)"
    endchoice

    config SSD1306_COLUMN_OFFSET
        int "Horizontal column offset"
        range 0 4
        default 0 if SSD1306_PANEL_SSD1306
        default 2 if SSD1306_PANEL_SH1106
        help
            Number of blank columns at the left of the 132-column RAM.
            Keep 0 for SSD1306 and 2 for SH1106 unless your image is shifted.

    config SSD1306_SEG_REMAP
        bool "Mirror horizontally (segment remap)"
        default y

    config SSD1306_COM_REMAP
        bool "Flip vertically (COM scan direction)"
        default y

endmenu
